---
import {getCollection} from "astro:content";
import Layout from "../layouts/Layout.astro";
import {sitePath} from "../paths";
import {CATEGORY_LABELS, STATUS_LABELS} from "../vocabulary";

const plants = (await getCollection("cards"))
  .map(({id, data}) => ({...data, id, commonName: data.commonNames[0]!}))
  .sort((a, b) => a.commonName.localeCompare(b.commonName, "it"));

// An empty card index means a wrong cards folder: better a failed build than
// a published site with no plants.
if (plants.length === 0) {
  throw new Error("No cards found: check the cards folder.");
}
---

<Layout>
  <h1>Le mie piante</h1>

  <form class="search" role="search" onsubmit="return false">
    <label class="search__label" for="plant-search">Cerca</label>
    <input
      id="plant-search"
      class="search__input"
      type="search"
      placeholder="Nome comune, botanico o alias"
      autocapitalize="off"
      spellcheck="false"
      enterkeyhint="search"
    />
  </form>

  <ul class="plant-list" role="list" aria-label="Piante">
    {
      plants.map((plant) => (
        <li
          class:list={["plant", `plant--${plant.status}`]}
          data-search-names={JSON.stringify([
            plant.botanicalName,
            ...plant.commonNames,
            ...plant.aliases,
          ])}
        >
          <div class="plant__names">
            <h2><a class="plant__link" href={sitePath(`schede/${plant.id}/`)}>{plant.commonName}</a></h2>
            <p class="plant__botanical-name">
              <i lang="la">{plant.botanicalName}</i>
            </p>
          </div>
          <p class="plant__tags">
            <span class="category">{CATEGORY_LABELS[plant.category]}</span>
            <span class:list={["status", `status--${plant.status}`]}>
              {STATUS_LABELS[plant.status]}
            </span>
          </p>
        </li>
      ))
    }
  </ul>

  <p class="no-results" id="no-results" role="status" hidden>
    Nessuna pianta trovata: non è nello schedario.
  </p>
</Layout>

<script>
  // Lowercase and strip accents, so "Èdera" and "edera" match.
  const normalize = (text: string) =>
    text
      .normalize("NFD")
      .replace(/\p{Diacritic}/gu, "")
      .toLowerCase()
      .trim();

  const input = document.querySelector<HTMLInputElement>("#plant-search")!;
  const noResults = document.querySelector<HTMLElement>("#no-results")!;
  const items = [
    ...document.querySelectorAll<HTMLElement>("[data-search-names]"),
  ].map((element) => ({
    element,
    names: (JSON.parse(element.dataset.searchNames!) as string[]).map(
      normalize,
    ),
  }));

  function applySearch() {
    const query = normalize(input.value);
    let visible = 0;
    for (const {element, names} of items) {
      const matches = names.some((name) => name.includes(query));
      element.hidden = !matches;
      if (matches) visible++;
    }
    noResults.hidden = visible > 0;
  }

  input.addEventListener("input", applySearch);
  // Back navigation restores the field value: apply it again to the list.
  window.addEventListener("pageshow", applySearch);
  applySearch();
</script>

<style>
  h1 {
    font-size: 1.625rem;
    line-height: 1.2;
    margin-block-end: var(--space);
  }

  .search {
    margin-block-end: var(--space);
  }

  .search__label {
    position: absolute;
    width: 1px;
    height: 1px;
    overflow: hidden;
    clip-path: inset(50%);
  }

  .search__input {
    width: 100%;
    min-height: 3rem;
    padding: 0.5rem 0.875rem;
    background: var(--surface);
    color: var(--text);
    border: 1px solid var(--border);
    border-radius: var(--radius);
    /* 16px or more: iOS does not zoom the page on focus. */
    font: inherit;
    font-size: 1rem;
  }

  .no-results {
    padding: var(--space);
    color: var(--text-muted);
    text-align: center;
  }

  .plant-list {
    display: grid;
    gap: 0.625rem;
  }

  .plant {
    position: relative;
    display: grid;
    gap: 0.5rem;
    padding: 0.875rem var(--space);
    background: var(--surface);
    border: 1px solid var(--border);
    border-radius: var(--radius);
  }

  /* A planned plant is not there yet: dashed border. */
  .plant--planned {
    background: transparent;
    border-style: dashed;
    border-color: var(--text-muted);
  }

  /* The whole row is the tap target. */
  .plant__link {
    color: inherit;
    text-decoration: none;
  }

  .plant__link::after {
    content: "";
    position: absolute;
    inset: 0;
  }

  .plant__names {
    min-width: 0;
  }

  h2 {
    font-size: 1.125rem;
    line-height: 1.25;
    overflow-wrap: anywhere;
  }

  .plant__botanical-name {
    color: var(--text-muted);
    font-size: 0.9375rem;
    overflow-wrap: anywhere;
  }

  .plant__tags {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 0.5rem;
    font-size: 0.8125rem;
  }

  .category {
    color: var(--text-muted);
  }

  .category::after {
    content: "·";
    margin-inline-start: 0.5rem;
  }

  .status {
    padding: 0.125rem 0.5rem;
    border-radius: 999px;
    font-weight: 600;
  }

  .status--growing {
    background: var(--growing-background);
    color: var(--growing-text);
  }

  .status--planned {
    background: var(--planned-background);
    color: var(--planned-text);
  }
</style>
