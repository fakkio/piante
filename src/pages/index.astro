---
import {getCollection} from "astro:content";
import Layout from "../layouts/Layout.astro";
import {CATEGORY_LABELS, STATUS_LABELS} from "../vocabulary";

const plants = (await getCollection("cards"))
  .map(({data}) => ({...data, commonName: data.commonNames[0]!}))
  .sort((a, b) => a.commonName.localeCompare(b.commonName, "it"));

// An empty card index means a wrong cards folder: better a failed build than
// a published site with no plants.
if (plants.length === 0) {
  throw new Error("No cards found: check the cards folder.");
}
---

<Layout>
  <h1>Le mie piante</h1>

  <ul class="plant-list" role="list" aria-label="Piante">
    {
      plants.map((plant) => (
        <li class:list={["plant", `plant--${plant.status}`]}>
          <div class="plant__names">
            <h2>{plant.commonName}</h2>
            <p class="plant__botanical-name">
              <i lang="la">{plant.botanicalName}</i>
            </p>
          </div>
          <p class="plant__tags">
            <span class="category">{CATEGORY_LABELS[plant.category]}</span>
            <span class:list={["status", `status--${plant.status}`]}>
              {STATUS_LABELS[plant.status]}
            </span>
          </p>
        </li>
      ))
    }
  </ul>
</Layout>

<style>
  h1 {
    font-size: 1.625rem;
    line-height: 1.2;
    margin-block-end: var(--space);
  }

  .plant-list {
    display: grid;
    gap: 0.625rem;
  }

  .plant {
    display: grid;
    gap: 0.5rem;
    padding: 0.875rem var(--space);
    background: var(--surface);
    border: 1px solid var(--border);
    border-radius: var(--radius);
  }

  /* A planned plant is not there yet: dashed border. */
  .plant--planned {
    background: transparent;
    border-style: dashed;
    border-color: var(--text-muted);
  }

  .plant__names {
    min-width: 0;
  }

  h2 {
    font-size: 1.125rem;
    line-height: 1.25;
    overflow-wrap: anywhere;
  }

  .plant__botanical-name {
    color: var(--text-muted);
    font-size: 0.9375rem;
    overflow-wrap: anywhere;
  }

  .plant__tags {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 0.5rem;
    font-size: 0.8125rem;
  }

  .category {
    color: var(--text-muted);
  }

  .category::after {
    content: "·";
    margin-inline-start: 0.5rem;
  }

  .status {
    padding: 0.125rem 0.5rem;
    border-radius: 999px;
    font-weight: 600;
  }

  .status--growing {
    background: var(--growing-background);
    color: var(--growing-text);
  }

  .status--planned {
    background: var(--planned-background);
    color: var(--planned-text);
  }
</style>
