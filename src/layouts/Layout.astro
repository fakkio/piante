---
import "../styles/global.css";
import {sitePath} from "../paths";

interface Props {
  title?: string;
}

const {title} = Astro.props;
const description =
  "Schedario di consultazione delle piante coltivate in casa, all'aperto e nell'orto.";
---

<!doctype html>
<html lang="it">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title ? `${title} · Piante` : "Piante"}</title>
    <meta name="description" content={description} />
    <meta name="theme-color" content="#2f6b3c" />
    <link rel="manifest" href={sitePath("manifest.webmanifest")} />
    <link rel="icon" type="image/svg+xml" href={sitePath("icon.svg")} />
    <link rel="apple-touch-icon" href={sitePath("apple-touch-icon.png")} />
    <meta name="apple-mobile-web-app-title" content="Piante" />
  </head>
  <body>
    <header class="site-header">
      <a class="site-header__title" href={sitePath()}>Piante</a>
    </header>
    <main>
      <slot />
    </main>
  </body>
</html>
